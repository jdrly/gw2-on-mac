; The exports of Wine's version.dll, same names and ordinals. Each forwards to the system's
; version.dll (proxy.c); the two VerLanguageName ones are kernel32's, as in Wine.
LIBRARY version.dll
EXPORTS
  GetFileVersionInfoA = proxy_GetFileVersionInfoA @1
  GetFileVersionInfoExA = proxy_GetFileVersionInfoExA @2
  GetFileVersionInfoExW = proxy_GetFileVersionInfoExW @3
  GetFileVersionInfoSizeA = proxy_GetFileVersionInfoSizeA @4
  GetFileVersionInfoSizeExA = proxy_GetFileVersionInfoSizeExA @5
  GetFileVersionInfoSizeExW = proxy_GetFileVersionInfoSizeExW @6
  GetFileVersionInfoSizeW = proxy_GetFileVersionInfoSizeW @7
  GetFileVersionInfoW = proxy_GetFileVersionInfoW @8
  VerFindFileA = proxy_VerFindFileA @9
  VerFindFileW = proxy_VerFindFileW @10
  VerInstallFileA = proxy_VerInstallFileA @11
  VerInstallFileW = proxy_VerInstallFileW @12
  VerLanguageNameA = kernel32.VerLanguageNameA @13
  VerLanguageNameW = kernel32.VerLanguageNameW @14
  VerQueryValueA = proxy_VerQueryValueA @15
  VerQueryValueW = proxy_VerQueryValueW @16
