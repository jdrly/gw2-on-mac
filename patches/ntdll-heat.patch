+unsigned int heat_mode;
+int heat_decided;
+
+#define HEAT_MAX_THREADS 1024
+
+struct heat_thread
+{
+    LONG               tid;        /* Windows thread id */
+    pthread_t          pthread;    /* for the sampler's pthread_kill (HEAT_PROF) */
+    int                exited;     /* left through heat_thread_exit */
+    unsigned long long utid;       /* macOS thread id (pthread_threadid_np) */
+    void              *start;      /* thread entry point */
+    int                qos;        /* heat_qos_map value applied (0: none) */
+    int                qos_ret;    /* thread_policy_set or setpriority result */
+    LONG               prio;       /* the base priority that asked for it */
+    unsigned long long c[HC_NB];
+    unsigned long long t[HT_NB];   /* ns */
+    /* the dumper's previous values */
+    unsigned long long pc[HC_NB], pt[HT_NB], pcpu_user, pcpu_sys;
+};
+
+static struct heat_thread heat_threads[HEAT_MAX_THREADS];
+static LONG heat_nthreads;
+
+static unsigned long long heat_req_n[REQ_NB_REQUESTS], heat_req_t[REQ_NB_REQUESTS];
+static unsigned long long heat_req_pn[REQ_NB_REQUESTS], heat_req_pt[REQ_NB_REQUESTS];
+
+/* callers in the main exe, by kind: the first two return addresses on the PE stack */
+enum { HK_CREATE_EVENT, HK_CLOSE, HK_YIELD, HK_DELAY0, HK_DELAY, HK_RELSEM, HK_ALERTWAIT, HK_NB };
+static const char * const heat_kind_names[HK_NB] = { "create_event", "close", "yield", "delay0", "delay", "relsem", "alertwait" };
+#define HEAT_CALLERS 1024
+struct heat_caller { unsigned long long key, n, pn; };
+static struct heat_caller heat_callers[HEAT_CALLERS];
+static unsigned long long heat_callers_lost;
+static ULONG_PTR heat_image_base, heat_code_lo, heat_code_hi;
+
+static double heat_ns_per_tick = 1.0;
+static unsigned int heat_interval = 5;
+static char heat_log_path[1024];
+
+/* event pool */
+#define HEAT_EV_ELIGIBLE 1
+#define HEAT_EV_MANUAL   2
+#define HEAT_EV_INPOOL   4
+#define HEAT_EVFLAGS_SIZE (1 << 22)   /* handles up to 16M */
+#define HEAT_POOL_SIZE   1024
+struct heat_pool { HANDLE h[HEAT_POOL_SIZE]; unsigned long long t[HEAT_POOL_SIZE]; unsigned int head, count; };
+static unsigned char *heat_evflags;
+static struct heat_pool heat_pools[2];   /* [0] auto-reset, [1] manual-reset */
+static pthread_mutex_t heat_pool_mutex = PTHREAD_MUTEX_INITIALIZER;
+static unsigned long long heat_pool_age_ns = 2000000;
+static unsigned long long heat_pool_evicted, heat_pool_forgotten, heat_pool_double_close;
+
+/* QoS per base priority -15..15 */
+static int heat_qos_map[31];
+static LONG heat_qos_limit[31], heat_qos_used[31];   /* "<prio>=<class>:<n>": at most n threads */
+static __thread int heat_spin_above;   /* this thread set itself above normal (HEAT_SPIN scope) */
+
+unsigned long long heat_now(void)
+{
+#ifdef __APPLE__
+    return (unsigned long long)(mach_absolute_time() * heat_ns_per_tick);
+#else
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * 1000000000ull + ts.tv_nsec;
+#endif
+}
+
+static struct heat_thread *heat_self(void)
+{
+    struct ntdll_thread_data *data;
+    struct heat_thread *t;
+    LONG i;
+
+    /* D3DMetal calls some Nt functions from threads that have no TEB */
+    if (!NtCurrentTeb()) return NULL;
+    data = ntdll_get_thread_data();
+    if ((t = data->heat)) return t;
+    i = InterlockedIncrement( &heat_nthreads ) - 1;
+    if (i >= HEAT_MAX_THREADS) i = HEAT_MAX_THREADS - 1;  /* shared overflow row */
+    t = &heat_threads[i];
+    if (!t->tid)
+    {
+        t->tid = HandleToLong( NtCurrentTeb()->ClientId.UniqueThread );
+#ifdef __APPLE__
+        pthread_threadid_np( NULL, &t->utid );
+#endif
+        t->start = data->start;
+        t->pthread = pthread_self();
+    }
+    data->heat = t;
+    return t;
+}
+
+void heat_count( enum heat_counter c )
+{
+    struct heat_thread *t;
+    if (!(heat_on() & HEAT_COUNT) || !(t = heat_self())) return;
+    t->c[c]++;
+}
+
+void heat_time( enum heat_timer which, unsigned long long start )
+{
+    struct heat_thread *t;
+    if (!(heat_on() & HEAT_COUNT) || !(t = heat_self())) return;
+    t->t[which] += heat_now() - start;
+}
+
+void heat_wait_done( unsigned long long start, const LARGE_INTEGER *timeout, NTSTATUS ret )
+{
+    struct heat_thread *t;
+    unsigned long long d;
+
+    if (!(heat_on() & HEAT_COUNT) || !(t = heat_self())) return;
+    d = heat_now() - start;
+    t->c[HC_WAIT]++;
+    t->t[HT_WAIT] += d;
+    if (timeout && !timeout->QuadPart) t->c[HC_WAIT0]++;
+    if (ret == STATUS_TIMEOUT) t->c[HC_WAIT_TIMEOUT]++;
+    if (d < 20000) t->c[HC_WAIT_B20US]++;
+    else if (d < 200000) t->c[HC_WAIT_B200US]++;
+    else if (d < 2000000) t->c[HC_WAIT_B2MS]++;
+    else t->c[HC_WAIT_LONG]++;
+}
+
+void heat_alertwait_done( unsigned long long start )
+{
+    struct heat_thread *t;
+    unsigned long long d;
+
+    if (!(heat_on() & HEAT_COUNT) || !(t = heat_self())) return;
+    d = heat_now() - start;
+    t->c[HC_ALERTWAIT]++;
+    t->t[HT_ALERTWAIT] += d;
+    if (d < 5000) t->c[HC_AW_B5US]++;
+    else if (d < 20000) t->c[HC_AW_B20US]++;
+    else if (d < 100000) t->c[HC_AW_B100US]++;
+    else t->c[HC_AW_LONG]++;
+}
+
+void heat_server_done( int req, unsigned long long start )
+{
+    struct heat_thread *t;
+    unsigned long long d;
+
+    if (!(heat_on() & HEAT_COUNT) || !(t = heat_self())) return;
+    d = heat_now() - start;
+    t->c[HC_SERVER]++;
+    t->t[HT_SERVER] += d;
+    if (req >= 0 && req < REQ_NB_REQUESTS)
+    {
+        __atomic_fetch_add( &heat_req_n[req], 1, __ATOMIC_RELAXED );
+        __atomic_fetch_add( &heat_req_t[req], d, __ATOMIC_RELAXED );
+    }
+}
+
+void heat_note_caller( int kind )
+{
+#ifdef __x86_64__
+    ULONG_PTR *sp, *top, found[2] = { 0, 0 };
+    unsigned long long key, zero;
+    unsigned int i, n = 0, h;
+
+    if (!(heat_on() & HEAT_COUNT) || !heat_code_hi || !heat_self()) return;
+    if (!(sp = heat_syscall_rsp())) return;
+    top = NtCurrentTeb()->Tib.StackBase;
+    for (i = 0; i < 256 && sp + 1 <= top && n < 2; i++, sp++)
+        if (*sp >= heat_code_lo && *sp < heat_code_hi) found[n++] = *sp - heat_image_base;
+    if (!n) return;
+    key = ((unsigned long long)(kind + 1) << 60) | ((found[0] & 0x3fffffff) << 30) | (found[1] & 0x3fffffff);
+    h = (unsigned int)((key * 0x9e3779b97f4a7c15ull) >> 54);
+    for (i = 0; i < 32; i++)
+    {
+        struct heat_caller *e = &heat_callers[(h + i) % HEAT_CALLERS];
+        unsigned long long k = __atomic_load_n( &e->key, __ATOMIC_ACQUIRE );
+        zero = 0;
+        if (k == key || (!k && (__atomic_compare_exchange_n( &e->key, &zero, key, FALSE, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE ) || zero == key)))
+        {
+            __atomic_fetch_add( &e->n, 1, __ATOMIC_RELAXED );
+            return;
+        }
+    }
+    __atomic_fetch_add( &heat_callers_lost, 1, __ATOMIC_RELAXED );
+#endif
+}
