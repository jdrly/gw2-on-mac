+/***********************************************************************
+ *  event pool
+ */
+
+static BOOL heat_evpool_args( ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr )
+{
+    if (access != EVENT_ALL_ACCESS) return FALSE;
+    if (!attr) return TRUE;
+    return !attr->RootDirectory && (!attr->ObjectName || !attr->ObjectName->Length) &&
+           !attr->SecurityDescriptor && !(attr->Attributes & OBJ_INHERIT);
+}
+
+static inline unsigned int heat_ev_index( HANDLE handle )
+{
+    return (unsigned int)(wine_server_obj_handle( handle ) >> 2);
+}
+
+BOOL heat_evpool_get( HANDLE *handle, ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr,
+                      EVENT_TYPE type, BOOLEAN state )
+{
+    struct heat_pool *pool = &heat_pools[type == NotificationEvent];
+    HANDLE h = 0;
+    sigset_t sigset;
+
+    if (!(heat_on() & HEAT_EVPOOL) || !heat_evpool_args( access, attr )) return FALSE;
+    server_enter_uninterrupted_section( &heat_pool_mutex, &sigset );
+    if (pool->count && heat_now() - pool->t[pool->head] >= heat_pool_age_ns)
+    {
+        h = pool->h[pool->head];
+        pool->head = (pool->head + 1) % HEAT_POOL_SIZE;
+        pool->count--;
+        heat_evflags[heat_ev_index( h )] &= ~HEAT_EV_INPOOL;
+    }
+    server_leave_uninterrupted_section( &heat_pool_mutex, &sigset );
+    if (!h) return FALSE;
+
+    if ((state ? NtSetEvent( h, NULL ) : NtResetEvent( h, NULL )))
+    {
+        heat_evpool_forget( h );
+        NtClose( h );
+        return FALSE;
+    }
+    *handle = h;
+    heat_count( HC_EVPOOL_HIT );
+    return TRUE;
+}
+
+void heat_evpool_created( HANDLE handle, ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr,
+                          EVENT_TYPE type )
+{
+    unsigned int idx;
+
+    if (!(heat_on() & HEAT_EVPOOL) || !heat_evpool_args( access, attr )) return;
+    if ((idx = heat_ev_index( handle )) >= HEAT_EVFLAGS_SIZE) return;
+    heat_evflags[idx] = HEAT_EV_ELIGIBLE | (type == NotificationEvent ? HEAT_EV_MANUAL : 0);
+}
+
+/* STATUS_PENDING: not ours, close it as usual */
+NTSTATUS heat_evpool_close( HANDLE handle )
+{
+    struct heat_pool *pool;
+    HANDLE evict = 0;
+    unsigned int idx, slot;
+    unsigned char flags;
+    sigset_t sigset;
+
+    if (!(heat_on() & HEAT_EVPOOL)) return STATUS_PENDING;
+    if ((idx = heat_ev_index( handle )) >= HEAT_EVFLAGS_SIZE) return STATUS_PENDING;
+    if (!(heat_evflags[idx] & HEAT_EV_ELIGIBLE)) return STATUS_PENDING;
+
+    server_enter_uninterrupted_section( &heat_pool_mutex, &sigset );
+    flags = heat_evflags[idx];
+    if (!(flags & HEAT_EV_ELIGIBLE))
+    {
+        server_leave_uninterrupted_section( &heat_pool_mutex, &sigset );
+        return STATUS_PENDING;
+    }
+    if (flags & HEAT_EV_INPOOL)  /* closed twice: what Windows says */
+    {
+        heat_pool_double_close++;
+        server_leave_uninterrupted_section( &heat_pool_mutex, &sigset );
+        return STATUS_INVALID_HANDLE;
+    }
+    pool = &heat_pools[!!(flags & HEAT_EV_MANUAL)];
+    if (pool->count == HEAT_POOL_SIZE)
+    {
+        evict = pool->h[pool->head];
+        pool->head = (pool->head + 1) % HEAT_POOL_SIZE;
+        pool->count--;
+        heat_evflags[heat_ev_index( evict )] = 0;
+        heat_pool_evicted++;
+    }
+    slot = (pool->head + pool->count) % HEAT_POOL_SIZE;
+    pool->h[slot] = handle;
+    pool->t[slot] = heat_now();
+    pool->count++;
+    heat_evflags[idx] = flags | HEAT_EV_INPOOL;
+    server_leave_uninterrupted_section( &heat_pool_mutex, &sigset );
+
+    if (evict) NtClose( evict );
+    heat_count( HC_EVPOOL_PUT );
+    return STATUS_SUCCESS;
+}
+
+/* the handle is duplicated or the server keeps a reference: close it for real later */
+void heat_evpool_forget( HANDLE handle )
+{
+    unsigned int idx;
+    sigset_t sigset;
+
+    if (!(heat_on() & HEAT_EVPOOL) || !handle) return;
+    if ((idx = heat_ev_index( handle )) >= HEAT_EVFLAGS_SIZE) return;
+    if (!(heat_evflags[idx] & HEAT_EV_ELIGIBLE)) return;
+    server_enter_uninterrupted_section( &heat_pool_mutex, &sigset );
+    if ((heat_evflags[idx] & (HEAT_EV_ELIGIBLE | HEAT_EV_INPOOL)) == HEAT_EV_ELIGIBLE)
+    {
+        heat_evflags[idx] = 0;
+        heat_pool_forgotten++;
+    }
+    server_leave_uninterrupted_section( &heat_pool_mutex, &sigset );
+}
+
+/***********************************************************************
+ *  private semaphores and their waiters (HEAT_WAKESKIP)
+ *
+ * msync wakes a semaphore's ulock address on every release, even with no thread asleep on it.
+ * Here each msync object counts the threads of this process asleep on its address
+ * (msync_wait_single), and a release of a semaphore that only this process can wait on (created
+ * here unnamed and non-inheritable, never duplicated, never had its handle flags changed) skips
+ * the wake when that count is 0. No lost wake: a waiter adds itself (sequentially consistent)
+ * before it sleeps, and the kernel's compare-and-wait sleeps only while the count it compares is
+ * still 0; the releaser changes the count (a full-barrier CAS) before it reads the waiters. If
+ * it reads none, the waiter's add comes later in that order, so its compare sees the new count
+ * and it doesn't sleep. Waits through the server (alertable or multi-object) are woken by msync's
+ * message to the server, which stays.
+ *
+ * With WINE_HEAT_CONTROL (HEAT_TRACK) the flags and counts are kept from the process's start
+ * whatever the wake mode, so "skip" can be switched on and off at runtime without a lost wake.
+ */
+#define HEAT_SEMFLAGS_SIZE (1 << 22)   /* handles up to 16M */
+#define HEAT_WAITERS_SIZE  (1 << 22)   /* msync objects up to 4M */
+static unsigned char *heat_semflags;
+static int *heat_waiters;
+__thread int heat_releasing_private;
+
+void heat_sem_created( HANDLE handle, const OBJECT_ATTRIBUTES *attr )
+{
+    unsigned int idx = heat_ev_index( handle );
+
+    if (!(heat_on() & (HEAT_WAKESKIP | HEAT_TRACK)) || !heat_semflags || idx >= HEAT_SEMFLAGS_SIZE) return;
+    if (attr && (attr->RootDirectory || (attr->ObjectName && attr->ObjectName->Length) ||
+                 (attr->Attributes & OBJ_INHERIT)))
+        return;
+    __atomic_store_n( &heat_semflags[idx], 1, __ATOMIC_RELEASE );
+}
+
+/* closed, duplicated, or its handle flags changed: no longer known to be private */
+void heat_handle_gone( HANDLE handle )
+{
+    unsigned int idx = heat_ev_index( handle );
+
+    if (!(heat_on() & (HEAT_WAKESKIP | HEAT_TRACK)) || !heat_semflags || idx >= HEAT_SEMFLAGS_SIZE) return;
+    if (__atomic_load_n( &heat_semflags[idx], __ATOMIC_RELAXED ))
+        __atomic_store_n( &heat_semflags[idx], 0, __ATOMIC_SEQ_CST );
+}
+
+BOOL heat_sem_private( HANDLE handle )
+{
+    unsigned int idx = heat_ev_index( handle );
+
+    if (!(heat_on() & (HEAT_WAKESKIP | HEAT_TRACK)) || !heat_semflags || idx >= HEAT_SEMFLAGS_SIZE) return FALSE;
+    return __atomic_load_n( &heat_semflags[idx], __ATOMIC_ACQUIRE );
+}
+
+void heat_waiters_add( int obj, int delta )
+{
+    if (!(heat_on() & (HEAT_WAKESKIP | HEAT_TRACK)) || !heat_waiters || obj <= 0 || obj >= HEAT_WAITERS_SIZE) return;
+    __atomic_fetch_add( &heat_waiters[obj], delta, __ATOMIC_SEQ_CST );
+}
+
+BOOL heat_waiters_none( int obj )
+{
+    if (!(heat_on() & (HEAT_WAKESKIP | HEAT_TRACK)) || !heat_waiters || obj <= 0 || obj >= HEAT_WAITERS_SIZE) return FALSE;
+    return !__atomic_load_n( &heat_waiters[obj], __ATOMIC_SEQ_CST );
+}
+
+/***********************************************************************
+ *  QoS
+ */
+
+/* Wine's server maps a priority to Mach policies (importance, timeshare, QoS tiers) and never
+ * to a QoS class, and once a thread has a Mach policy macOS refuses pthread QoS (EPERM). Cores
+ * follow the base priority: on the M5 Max at load, a thread at base priority 20 (the utility
+ * band) gets the P cores as utility QoS does, one below that the P cores' clock drops, and Wine's
+ * ABOVE_NORMAL (task priority + 5) takes the S cores. The task's priority differs (31 for a
+ * console program, 26 for GW2), so the map sets a base priority: it sets the thread's precedence
+ * importance to that minus the task's, after the server's, or Darwin background. */
+#define HEAT_CLASS_BG  1000   /* setpriority( PRIO_DARWIN_THREAD, PRIO_DARWIN_BG ) */
+#define HEAT_CLASS_PRI 100    /* map value = HEAT_CLASS_PRI + base priority */
+
+static const struct { const char *name; int value; } heat_qos_names[] =
+{
+    { "default", HEAT_CLASS_PRI + 31 },
+    { "utility", HEAT_CLASS_PRI + 20 },
+    { "background", HEAT_CLASS_BG },
+};
+
+static void heat_qos_format( int value, char *buf, size_t size )
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(heat_qos_names); i++)
+        if (heat_qos_names[i].value == value)
+        {
+            snprintf( buf, size, "%s", heat_qos_names[i].name );
+            return;
+        }
+    snprintf( buf, size, "priority %d", value - HEAT_CLASS_PRI );
+}
+
+/* "<Windows priority>=<utility|default|background|base priority>,..." */
+static BOOL heat_parse_qos( const char *spec )
+{
+    char buf[256], *p, *save = NULL, *end;
+    BOOL any = FALSE;
+    unsigned int i;
+
+    snprintf( buf, sizeof(buf), "%s", spec );
+    for (p = strtok_r( buf, ",", &save ); p; p = strtok_r( NULL, ",", &save ))
+    {
+        char *eq = strchr( p, '=' ), *colon;
+        long prio, imp, limit = 0;
+        if (!eq) continue;
+        *eq = 0;
+        prio = strtol( p, NULL, 10 );
+        if (prio < -15 || prio > 15) continue;
+        if ((colon = strchr( eq + 1, ':' )))
+        {
+            *colon = 0;
+            limit = strtol( colon + 1, &end, 10 );
+            if (end == colon + 1 || *end || limit < 1) continue;
+        }
+        heat_qos_limit[prio + 15] = limit;
+        for (i = 0; i < ARRAY_SIZE(heat_qos_names); i++)
+            if (!strcmp( eq + 1, heat_qos_names[i].name ))
+            {
+                heat_qos_map[prio + 15] = heat_qos_names[i].value;
+                any = TRUE;
+            }
+        imp = strtol( eq + 1, &end, 10 );
+        if (end != eq + 1 && !*end && imp >= 4 && imp <= 63)
+        {
+            heat_qos_map[prio + 15] = HEAT_CLASS_PRI + imp;
+            any = TRUE;
+        }
+    }
+    return any;
+}
+
+/* the current thread gets a heat_qos_map value; returns the system call's result */
+static int heat_apply_class( int value )
+{
+    int ret = -1;
+#ifdef __APPLE__
+    if (value == HEAT_CLASS_BG)
+        ret = setpriority( PRIO_DARWIN_THREAD, 0, PRIO_DARWIN_BG );
+    else
+    {
+        /* the task's priority: the thread's base priority less the importance the server set */
+        mach_port_t port = pthread_mach_thread_np( pthread_self() );
+        struct thread_precedence_policy policy;
+        mach_msg_type_number_t count = THREAD_PRECEDENCE_POLICY_COUNT;
+        boolean_t get_default = FALSE;
+        struct proc_threadinfo pti;
+        unsigned long long utid;
+
+        pthread_threadid_np( NULL, &utid );
+        if (thread_policy_get( port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&policy, &count, &get_default ) ||
+            proc_pidinfo( getpid(), PROC_PIDTHREADID64INFO, utid, &pti, sizeof(pti) ) != sizeof(pti))
+            ret = -2;
+        else
+        {
+            policy.importance = (value - HEAT_CLASS_PRI) - (pti.pth_priority - policy.importance);
+            ret = thread_policy_set( port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&policy,
+                                     THREAD_PRECEDENCE_POLICY_COUNT );
+        }
+    }
+#endif
+    return ret;
+}
+
+void heat_thread_priority( HANDLE handle, LONG priority )
+{
+    struct heat_thread *t;
+    int value, ret;
+
+    if ((heat_on() & (HEAT_SPINLOCK | HEAT_SPINEVENT)) && handle == NtCurrentThread())
+        heat_spin_above = priority > 0;
+    if (!(heat_on() & HEAT_QOS) || handle != NtCurrentThread()) return;
+    if (priority < -15 || priority > 15 || !(value = heat_qos_map[priority + 15])) return;
+    if (heat_qos_limit[priority + 15])
+    {
+        /* a thread already given this class doesn't count again */
+        if (!(t = heat_self())) return;
+        if (!(t->qos == value && t->prio == priority) &&
+            InterlockedIncrement( &heat_qos_used[priority + 15] ) > heat_qos_limit[priority + 15]) return;
+    }
+    ret = heat_apply_class( value );
+    if ((t = heat_self()))
+    {
+        t->qos = value;
+        t->qos_ret = ret;
+        t->prio = priority;
+    }
+}
+
+/* WINE_HEAT_NAMEPRI: "<thread name>=<class or base priority>;..." (names may hold commas) */
+#define HEAT_NAMES 8
+static struct { WCHAR name[64]; int value; } heat_names[HEAT_NAMES];
+static unsigned int heat_nnames;
+
+static BOOL heat_parse_names( const char *spec )
+{
+    char buf[512], *p, *save = NULL;
+    unsigned int i, len;
+
+    snprintf( buf, sizeof(buf), "%s", spec );
+    for (p = strtok_r( buf, ";", &save ); p && heat_nnames < HEAT_NAMES; p = strtok_r( NULL, ";", &save ))
+    {
+        char *eq = strrchr( p, '=' ), *end;
+        int value = 0;
+        long pri;
+        if (!eq || eq == p) continue;
+        *eq = 0;
+        for (i = 0; i < ARRAY_SIZE(heat_qos_names); i++)
+            if (!strcmp( eq + 1, heat_qos_names[i].name )) value = heat_qos_names[i].value;
+        pri = strtol( eq + 1, &end, 10 );
+        if (end != eq + 1 && !*end && pri >= 4 && pri <= 63) value = HEAT_CLASS_PRI + pri;
+        if (!value) continue;
+        len = strlen( p );
+        if (len >= ARRAY_SIZE(heat_names[0].name)) continue;
+        for (i = 0; i <= len; i++) heat_names[heat_nnames].name[i] = (unsigned char)p[i];
+        heat_names[heat_nnames++].value = value;
+    }
+    return heat_nnames != 0;
+}
+
+void heat_thread_named( HANDLE handle, const UNICODE_STRING *name )
+{
+    THREAD_BASIC_INFORMATION tbi;
+    struct heat_thread *t;
+    unsigned int i, j, len;
+    int ret;
+
+    if (!(heat_on() & HEAT_NAMEPRI) || !name || !name->Buffer) return;
+    if (handle != NtCurrentThread() &&
+        (NtQueryInformationThread( handle, ThreadBasicInformation, &tbi, sizeof(tbi), NULL ) ||
+         tbi.ClientId.UniqueThread != NtCurrentTeb()->ClientId.UniqueThread))
+        return;  /* only a thread naming itself */
+    len = name->Length / sizeof(WCHAR);
+    for (i = 0; i < heat_nnames; i++)
+    {
+        for (j = 0; j < len && heat_names[i].name[j] == name->Buffer[j]; j++) ;
+        if (j != len || heat_names[i].name[len]) continue;
+        ret = heat_apply_class( heat_names[i].value );
+        if ((t = heat_self()))
+        {
+            t->qos = heat_names[i].value;
+            t->qos_ret = ret;
+            t->prio = 99;  /* by name */
+        }
+        return;
+    }
+}
+
+/***********************************************************************
+ *  HEAT_PROF: a SIGPROF sampler of the game thread's x86 context
+ *
+ * A raw pthread (no Windows code, every signal blocked) sends SIGPROF to the target threads at
+ * WINE_HEAT_PROF_HZ (default 1000). Under Rosetta the handler's ucontext holds the emulated x86
+ * registers. If the thread was in Wine's unix code (its rsp on the thread's kernel stack), the PE
+ * registers come from the syscall frame instead, so the sample belongs to the PE code that made
+ * the call. The handler copies the PE registers and up to HEAT_PROF_STACK bytes of the PE stack
+ * into a per-target ring; the sampler thread writes the rings to
+ * $WINE_HEAT_LOG/heat-prof-<pid>.bin, and the loaded modules to heat-prof-<pid>.modules, for
+ * work/heat/tools/profread.py (unwinds with each image's .pdata). Targets (WINE_HEAT_PROF_THREADS,
+ * the control file's "targets="): the busiest unnamed thread that started in the exe (the game
+ * thread), and by name bgfx's render thread and DXMT's encode and finish threads. A sample in
+ * unix code also records the unix rbp chain (bounded by the kernel stack); the sampler thread
+ * names each new unix address with dladdr in heat-prof-<pid>.usyms, and writes each target's CPU
+ * time per second to heat-prof-<pid>.threads (wall-clock samples include blocked time).
+ * WINE_HEAT_PROF=on starts it; WINE_HEAT_CONTROL's "prof=on" too.
+ * A thread leaves the targets in heat_thread_exit, under the same lock the sampler holds
+ * around pthread_kill, so no signal goes to a thread that has exited.
+ */
+#define HEAT_PROF_STACK 2048
+#define HEAT_PROF_RING  1024
+#define HEAT_PROF_TARGETS 4 /* 0 game, 1 render (bgfx), 2 dxmt-encode, 3 dxmt-finish */
+#define HEAT_PROF_UNIX  1   /* the thread was in Wine's unix code; regs are the syscall's PE regs */
+#define HEAT_PROF_UFRAMES 24 /* unix return addresses from the rbp chain on the kernel stack */
+#define HEAT_PROF_USYMS (1 << 17)
+
+static const char * const heat_prof_target_names[HEAT_PROF_TARGETS] = { "game", "render", "encode", "finish" };
+
+struct heat_prof_rec
+{
+    unsigned long long t;         /* mach ticks */
+    unsigned int       target;    /* 0 game, 1 render, 2 encode, 3 finish */
+    unsigned int       flags;     /* HEAT_PROF_UNIX */
+    unsigned int       stack_len; /* bytes of stack[] valid, from regs[7] up */
+    unsigned int       tid;
+    unsigned long long unix_rip;  /* where in the unix side, with HEAT_PROF_UNIX */
+    ULONG64            regs[17];  /* rax rbx rcx rdx rsi rdi rbp rsp r8-r15 rip */
+    unsigned long long unix_rsp0; /* with HEAT_PROF_UNIX: the word at the unix rsp (a frameless leaf's return) */
+    unsigned int       nuframes;  /* valid uframes[] */
+    unsigned int       pad;
+    unsigned long long uframes[HEAT_PROF_UFRAMES]; /* the unix rbp chain's return addresses */
+    unsigned char      stack[HEAT_PROF_STACK];
+};
+
+struct heat_prof_ring
+{
+    pthread_t                    thread;   /* 0: no target */
+    struct heat_thread          *slot;
+    unsigned int                 write, read;
+    unsigned long long           sent, dropped;
+    struct heat_prof_rec         recs[HEAT_PROF_RING];
+};
+
+static struct heat_prof_ring *heat_prof_rings;  /* [HEAT_PROF_TARGETS], mmapped */
+static os_unfair_lock heat_prof_lock = OS_UNFAIR_LOCK_INIT;
+static unsigned int heat_prof_hz = 1000, heat_prof_want = 1;  /* bit per target */
+static char heat_prof_path[1024], heat_prof_modules_path[1024], heat_control_path[1024];
+static char heat_prof_usyms_path[1024], heat_prof_threads_path[1024];
+static unsigned long long *heat_prof_usyms;  /* unix addresses already named, open addressing */
+
+/* "game,render,encode,finish", "dxmt" (encode and finish), "all": a bit per target */
+static unsigned int heat_prof_parse_targets( const char *s )
+{
+    unsigned int mask = 0, i;
+    const char *p = s;
+
+    while (*p && *p != ' ' && *p != '\n')
+    {
+        size_t len = strcspn( p, ", \n" );
+        if (len == 4 && !strncmp( p, "dxmt", 4 )) mask |= 4 | 8;
+        else if (len == 3 && !strncmp( p, "all", 3 )) mask |= (1 << HEAT_PROF_TARGETS) - 1;
+        else
+            for (i = 0; i < HEAT_PROF_TARGETS; i++)
+                if (len == strlen( heat_prof_target_names[i] ) && !strncmp( p, heat_prof_target_names[i], len )) mask |= 1 << i;
+        p += len;
+        if (*p == ',') p++;
+    }
+    return mask;
+}
+
+static void heat_prof_handler( int sig, siginfo_t *info, void *ucv )
+{
+    ucontext_t *uc = ucv;
+    struct heat_prof_ring *r = NULL;
+    struct heat_prof_rec *rec;
+    struct ntdll_thread_data *data;
+    pthread_t self = pthread_self();
+    unsigned int i, w;
+    ULONG_PTR rsp, lo, hi;
+    TEB *teb;
+    int saved_errno = errno;
+
+    if (!heat_prof_rings || !(teb = NtCurrentTeb())) goto done;
+    for (i = 0; i < HEAT_PROF_TARGETS; i++)
+        if (heat_prof_rings[i].thread == self) { r = &heat_prof_rings[i]; break; }
+    if (!r) goto done;
+    w = r->write;
+    if (w - __atomic_load_n( &r->read, __ATOMIC_ACQUIRE ) >= HEAT_PROF_RING) { r->dropped++; goto done; }
+    rec = &r->recs[w % HEAT_PROF_RING];
+    rec->t = mach_absolute_time();
+    rec->target = i;
+    rec->tid = HandleToULong( teb->ClientId.UniqueThread );
+    rec->flags = 0;
+    rec->unix_rip = 0;
+    rec->unix_rsp0 = 0;
+    rec->nuframes = 0;
+    rec->stack_len = 0;
+    data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    rsp = uc->uc_mcontext->__ss.__rsp;
+    if (rsp >= (ULONG_PTR)data->kernel_stack && rsp < (ULONG_PTR)data->kernel_stack + kernel_stack_size)
+    {
+        ULONG_PTR ks = (ULONG_PTR)data->kernel_stack, ke = ks + kernel_stack_size, fp, next;
+        unsigned int n = 0;
+
+        rec->flags = HEAT_PROF_UNIX;
+        rec->unix_rip = uc->uc_mcontext->__ss.__rip;
+        heat_syscall_pe_regs( rec->regs );
+        /* the unix side's frame-pointer chain, only within this thread's kernel stack */
+        rec->unix_rsp0 = !(rsp & 7) && rsp + 8 <= ke ? *(const unsigned long long *)rsp : 0;
+        fp = uc->uc_mcontext->__ss.__rbp;
+        while (n < HEAT_PROF_UFRAMES && fp >= rsp && fp >= ks && fp + 16 <= ke && !(fp & 7))
+        {
+            rec->uframes[n++] = ((const unsigned long long *)fp)[1];
+            next = ((const unsigned long long *)fp)[0];
+            if (next <= fp) break;
+            fp = next;
+        }
+        rec->nuframes = n;
+    }
+    else
+    {
+        const _STRUCT_X86_THREAD_STATE64 *ss = &uc->uc_mcontext->__ss;
+        rec->regs[0] = ss->__rax; rec->regs[1] = ss->__rbx; rec->regs[2] = ss->__rcx; rec->regs[3] = ss->__rdx;
+        rec->regs[4] = ss->__rsi; rec->regs[5] = ss->__rdi; rec->regs[6] = ss->__rbp; rec->regs[7] = ss->__rsp;
+        rec->regs[8] = ss->__r8; rec->regs[9] = ss->__r9; rec->regs[10] = ss->__r10; rec->regs[11] = ss->__r11;
+        rec->regs[12] = ss->__r12; rec->regs[13] = ss->__r13; rec->regs[14] = ss->__r14; rec->regs[15] = ss->__r15;
+        rec->regs[16] = ss->__rip;
+    }
+    /* the PE stack above rsp, within the thread's PE stack only */
+    lo = rec->regs[7];
+    hi = (ULONG_PTR)teb->Tib.StackBase;
+    if (lo >= (ULONG_PTR)teb->Tib.StackLimit && lo < hi)
+    {
+        rec->stack_len = hi - lo < HEAT_PROF_STACK ? hi - lo : HEAT_PROF_STACK;
+        memcpy( rec->stack, (const void *)lo, rec->stack_len );
+    }
+    __atomic_store_n( &r->write, w + 1, __ATOMIC_RELEASE );
+done:
+    errno = saved_errno;
+}
+
+void heat_thread_start(void)
+{
+    if (heat_on() & (HEAT_PROF | HEAT_LIVE)) heat_self();
+}
+
+void heat_thread_exit(void)
+{
+    struct ntdll_thread_data *data;
+    unsigned int i;
+
+    if (!heat_prof_rings || !NtCurrentTeb()) return;
+    data = ntdll_get_thread_data();
+    os_unfair_lock_lock( &heat_prof_lock );
+    for (i = 0; i < HEAT_PROF_TARGETS; i++)
+        if (heat_prof_rings[i].thread == pthread_self()) heat_prof_rings[i].thread = 0;
+    if (data->heat) ((struct heat_thread *)data->heat)->exited = 1;
+    os_unfair_lock_unlock( &heat_prof_lock );
+}
+
+/* the targets heat_prof_want asks for: the busiest thread over the last second that started in
+ * the exe and has no name (the game thread), and by name (the busiest of each) bgfx's render
+ * thread and DXMT's encode and finish threads. With a threads file, each target's CPU time since
+ * the last call: "C <s> <target> <tid> <cpu ms> <wall ms>". */
+static void heat_prof_retarget( FILE *tf, unsigned long long wall_ns )
+{
+    static unsigned long long prev[HEAT_MAX_THREADS];
+    LONG i, n = heat_nthreads < HEAT_MAX_THREADS ? heat_nthreads : HEAT_MAX_THREADS;
+    struct heat_thread *best[HEAT_PROF_TARGETS] = { NULL };
+    unsigned long long best_d[HEAT_PROF_TARGETS] = { 0 };
+    unsigned int want = __atomic_load_n( &heat_prof_want, __ATOMIC_RELAXED ), k;
+
+    for (i = 0; i < n; i++)
+    {
+        struct heat_thread *t = &heat_threads[i];
+        struct proc_threadinfo pti;
+        unsigned long long cpu, d;
+
+        if (t->exited || !t->pthread || !t->utid) continue;
+        if (proc_pidinfo( getpid(), PROC_PIDTHREADID64INFO, t->utid, &pti, sizeof(pti) ) != sizeof(pti)) continue;
+        cpu = pti.pth_user_time + pti.pth_system_time;
+        d = cpu - prev[i];
+        prev[i] = cpu;
+        if (!strncmp( pti.pth_name, "bgfx - renderer", 15 )) k = 1;
+        else if (!strncmp( pti.pth_name, "dxmt-encode", 11 )) k = 2;
+        else if (!strncmp( pti.pth_name, "dxmt-finish", 11 )) k = 3;
+        else if (pti.pth_name[0]) continue;
+        else if ((ULONG_PTR)t->start < heat_image_base || (ULONG_PTR)t->start >= heat_code_hi) continue;
+        else k = 0;
+        if (!best[k] || d > best_d[k]) { best_d[k] = d; best[k] = t; }
+    }
+    os_unfair_lock_lock( &heat_prof_lock );
+    for (k = 0; k < HEAT_PROF_TARGETS; k++)
+    {
+        if (!(want & (1 << k))) { heat_prof_rings[k].thread = 0; continue; }
+        if (!best[k] || best[k]->exited) continue;  /* keep the last one until it exits */
+        heat_prof_rings[k].thread = best[k]->pthread;
+        heat_prof_rings[k].slot = best[k];
+    }
+    os_unfair_lock_unlock( &heat_prof_lock );
+    if (tf && wall_ns)
+    {
+        for (k = 0; k < HEAT_PROF_TARGETS; k++)
+            if ((want & (1 << k)) && best[k])
+                fprintf( tf, "C %.3f %s %x %.3f %.3f\n", heat_now() / 1e9, heat_prof_target_names[k],
+                         (unsigned int)best[k]->tid, best_d[k] / 1e6, wall_ns / 1e6 );
+        fflush( tf );
+    }
+}
+
+/* the loaded PE modules, again whenever their number changed (a sampler on from the process's
+ * start sees an empty list first) */
+static void heat_prof_write_modules(void)
+{
+    static unsigned int last;
+    LIST_ENTRY *head, *e;
+    unsigned int count = 0;
+    FILE *f;
+
+    if (!peb || !peb->LdrData) return;
+    head = &peb->LdrData->InLoadOrderModuleList;
+    for (e = head->Flink; e && e != head && count < 4096; e = e->Flink) count++;
+    if (!count || count == last || !(f = fopen( heat_prof_modules_path, "a" ))) return;
+    last = count;
+    fprintf( f, "T %.3f\n", heat_now() / 1e9 );
+    head = &peb->LdrData->InLoadOrderModuleList;
+    for (e = head->Flink; e && e != head; e = e->Flink)
+    {
+        const LDR_DATA_TABLE_ENTRY *m = CONTAINING_RECORD( e, LDR_DATA_TABLE_ENTRY, InLoadOrderLinks );
+        char name[260];
+        unsigned int k, len = m->FullDllName.Length / sizeof(WCHAR);
+        if (len >= sizeof(name)) len = sizeof(name) - 1;
+        for (k = 0; k < len; k++) name[k] = m->FullDllName.Buffer[k] < 128 ? (char)m->FullDllName.Buffer[k] : '?';
+        name[len] = 0;
+        fprintf( f, "%p %#lx %s\n", m->DllBase, (unsigned long)m->SizeOfImage, name );
+    }
+    fclose( f );
+}
+
+/* names a unix address once per process in the .usyms file: "<addr> <image base> <image> <symbol> <symbol addr>" */
+static void heat_prof_usym( FILE *uf, unsigned long long addr )
+{
+    unsigned int h, k;
+    Dl_info info;
+
+    if (!addr || !heat_prof_usyms || !uf) return;
+    h = (unsigned int)((addr * 0x9E3779B97F4A7C15ull) >> 47) & (HEAT_PROF_USYMS - 1);
+    for (k = 0; k < 64; k++, h = (h + 1) & (HEAT_PROF_USYMS - 1))
+    {
+        if (heat_prof_usyms[h] == addr) return;
+        if (!heat_prof_usyms[h]) break;
+    }
+    if (k == 64) return;  /* full around here: leave it unnamed */
+    heat_prof_usyms[h] = addr;
+    memset( &info, 0, sizeof(info) );
+    if (dladdr( (void *)addr, &info ) && info.dli_fname)
+        fprintf( uf, "%#llx %p %s %s %p\n", addr, info.dli_fbase, info.dli_fname,
+                 info.dli_sname ? info.dli_sname : "?", info.dli_saddr );
+    else
+        fprintf( uf, "%#llx 0 ? ? 0\n", addr );
+}
+
+static void heat_prof_drain( FILE *f, FILE *uf )
+{
+    unsigned int i, k;
+
+    for (i = 0; i < HEAT_PROF_TARGETS; i++)
+    {
+        struct heat_prof_ring *r = &heat_prof_rings[i];
+        unsigned int w = __atomic_load_n( &r->write, __ATOMIC_ACQUIRE );
+        while (r->read != w)
+        {
+            const struct heat_prof_rec *rec = &r->recs[r->read % HEAT_PROF_RING];
+            fwrite( rec, offsetof(struct heat_prof_rec, stack) + rec->stack_len, 1, f );
+            if (rec->flags & HEAT_PROF_UNIX)
+            {
+                heat_prof_usym( uf, rec->unix_rip );
+                heat_prof_usym( uf, rec->unix_rsp0 );
+                for (k = 0; k < rec->nuframes && k < HEAT_PROF_UFRAMES; k++) heat_prof_usym( uf, rec->uframes[k] );
+            }
+            __atomic_store_n( &r->read, r->read + 1, __ATOMIC_RELEASE );
+        }
+    }
+    fflush( f );
+    if (uf) fflush( uf );
+}
+
+static void *heat_prof_thread( void *arg )
+{
+    struct timespec tick = { 0, 1000000000 / heat_prof_hz };
+    unsigned long long last_target = 0, last_drain = 0;
+    unsigned int was_on = 0, i;
+    FILE *f = NULL, *uf = NULL, *tf = NULL;
+
+    for (;;)
+    {
+        unsigned long long now = heat_now();
+        unsigned int on = __atomic_load_n( &heat_mode, __ATOMIC_RELAXED ) & HEAT_PROF;
+
+        if (on && !was_on)
+        {
+            if (!f && (f = fopen( heat_prof_path, "ab" )))
+            {
+                /* header: magic, record layout, image, tick rate */
+                fprintf( f, "HEATPRF2 rec %u stack %u image %#lx code %#lx-%#lx ns_per_tick %.9f hz %u uframes %u\n",
+                         (unsigned int)offsetof(struct heat_prof_rec, stack), HEAT_PROF_STACK,
+                         (unsigned long)heat_image_base, (unsigned long)heat_code_lo,
+                         (unsigned long)heat_code_hi, heat_ns_per_tick, heat_prof_hz, HEAT_PROF_UFRAMES );
+                fflush( f );
+            }
+            if (!uf) uf = fopen( heat_prof_usyms_path, "a" );
+            if (!tf) tf = fopen( heat_prof_threads_path, "a" );
+            if (tf) { fprintf( tf, "T %.3f want %#x\n", heat_now() / 1e9, heat_prof_want ); fflush( tf ); }
+            heat_prof_write_modules();
+            heat_prof_retarget( NULL, 0 );
+            last_target = now;
+        }
+        if (!on && was_on)
+        {
+            os_unfair_lock_lock( &heat_prof_lock );
+            for (i = 0; i < HEAT_PROF_TARGETS; i++) heat_prof_rings[i].thread = 0;
+            os_unfair_lock_unlock( &heat_prof_lock );
+        }
+        was_on = on;
+        if (on)
+        {
+            if (now - last_target >= 1000000000ull)
+            {
+                heat_prof_retarget( tf, now - last_target );
+                heat_prof_write_modules();
+                last_target = now;
+            }
+            os_unfair_lock_lock( &heat_prof_lock );
+            for (i = 0; i < HEAT_PROF_TARGETS; i++)
+                if (heat_prof_rings[i].thread && !pthread_kill( heat_prof_rings[i].thread, SIGPROF ))
+                    heat_prof_rings[i].sent++;
+            os_unfair_lock_unlock( &heat_prof_lock );
+        }
+        if (f && now - last_drain >= 100000000ull) { heat_prof_drain( f, uf ); last_drain = now; }
+        if (on) nanosleep( &tick, NULL );
+        else { struct timespec idle = { 0, 100000000 }; nanosleep( &idle, NULL ); }
+    }
+    return NULL;
+}
+
+/* WINE_HEAT_CONTROL: "wake=off|one|skip|one,skip count=on|off prof=on|off", read every second */
+static void heat_control_poll( FILE *log )
+{
+    static char last[256];
+    char buf[256], *p;
+    unsigned int mode, newmode;
+    FILE *f;
+    size_t n;
+
+    if (!heat_control_path[0] || !(f = fopen( heat_control_path, "r" ))) return;
+    n = fread( buf, 1, sizeof(buf) - 1, f );
+    fclose( f );
+    buf[n] = 0;
+    if (!strcmp( buf, last )) return;
+    strcpy( last, buf );
+    mode = newmode = __atomic_load_n( &heat_mode, __ATOMIC_RELAXED );
+    if ((p = strstr( buf, "wake=" )))
+    {
+        newmode &= ~(HEAT_WAKE | HEAT_WAKESKIP);
+        if (!strncmp( p + 5, "one", 3 ) || strstr( p, ",one" )) newmode |= HEAT_WAKE;
+        if (strstr( p, "skip" ) && (mode & HEAT_TRACK)) newmode |= HEAT_WAKESKIP;
+    }
+    if ((p = strstr( buf, "count=" ))) newmode = (newmode & ~HEAT_COUNT) | (!strncmp( p + 6, "on", 2 ) ? HEAT_COUNT : 0);
+    if ((p = strstr( buf, "prof=" ))) newmode = (newmode & ~HEAT_PROF) | (!strncmp( p + 5, "on", 2 ) && heat_prof_rings ? HEAT_PROF : 0);
+    if ((p = strstr( buf, "targets=" )) && heat_prof_parse_targets( p + 8 ))
+        __atomic_store_n( &heat_prof_want, heat_prof_parse_targets( p + 8 ), __ATOMIC_RELAXED );
+    __atomic_store_n( &heat_mode, newmode, __ATOMIC_SEQ_CST );
+    if (log)
+    {
+        fprintf( log, "control %.1f mode %#x -> %#x (%s)\n", heat_now() / 1e9, mode, newmode, strtok( buf, "\n" ) ? buf : "" );
+        fflush( log );
+    }
+}
+
+/***********************************************************************
+ *  spin (HEAT_SPINLOCK, HEAT_SPINEVENT)
+ */
+
+static unsigned long long heat_spin_max[2];   /* ns, from WINE_HEAT_SPIN */
+static unsigned int heat_spin_pause = 32;
+static int heat_spin_all[2];                            /* ":all" scope; default ":game" */
+static __thread unsigned int heat_spin_misses[2];      /* this thread's misses in a row */
+static __thread unsigned int heat_spin_skip[2];        /* waits left without spinning */
+#define HEAT_SPIN_MISSES 4
+
+/* "lock=<us>,event=<us>" */
+static unsigned int heat_parse_spin( const char *spec )
+{
+    char buf[128], *p, *save = NULL, *end;
+    unsigned int mode = 0;
+    long us;
+
+    snprintf( buf, sizeof(buf), "%s", spec );
+    for (p = strtok_r( buf, ",", &save ); p; p = strtok_r( NULL, ",", &save ))
+    {
+        char *eq = strchr( p, '=' );
+        if (!eq) continue;
+        *eq = 0;
+        us = strtol( eq + 1, &end, 10 );
+        if (end == eq + 1 || us < 1 || us > 1000) continue;
+        if (*end && strcmp( end, ":game" ) && strcmp( end, ":all" )) continue;
+        if (!strcmp( p, "lock" ))
+        {
+            heat_spin_max[HEAT_SPIN_LOCK] = us * 1000;
+            heat_spin_all[HEAT_SPIN_LOCK] = !strcmp( end, ":all" );
+            mode |= HEAT_SPINLOCK;
+        }
+        if (!strcmp( p, "event" ))
+        {
+            heat_spin_max[HEAT_SPIN_EVENT] = us * 1000;
+            heat_spin_all[HEAT_SPIN_EVENT] = !strcmp( end, ":all" );
+            mode |= HEAT_SPINEVENT;
+        }
+    }
+    return mode;
+}
+
+/* how long this thread may spin now (ns), 0 for not at all */
+unsigned long long heat_spin_budget( int kind )
+{
+    if (heat_spin_above && !heat_spin_all[kind]) { heat_count( HC_SPIN_SCOPED ); return 0; }
+    if (heat_spin_skip[kind])
+    {
+        heat_spin_skip[kind]--;
+        heat_count( HC_SPIN_OFF );
+        return 0;
+    }
+    return heat_spin_max[kind];
+}
+
+void heat_spin_result( int kind, int hit, unsigned long long start )
+{
+    heat_time( HT_SPIN, start );
+    if (hit)
+    {
+        heat_count( kind == HEAT_SPIN_LOCK ? HC_LSPIN_HIT : HC_ESPIN_HIT );
+        heat_spin_misses[kind] = 0;
+        return;
+    }
+    heat_count( kind == HEAT_SPIN_LOCK ? HC_LSPIN_MISS : HC_ESPIN_MISS );
+    if (++heat_spin_misses[kind] >= HEAT_SPIN_MISSES)
+    {
+        heat_spin_misses[kind] = 0;
+        heat_spin_skip[kind] = heat_spin_pause;
+    }
+}
+
+/* NtWaitForAlertByThreadId's futex word: 0 idle, 1 alerted; 3 while this spins. The waker
+ * (InterlockedExchange to 1, a wake syscall only if it was 0) needs no change. Returns 1 if the
+ * alert came and was taken, 0 to sleep as before (the word is back to 0 or 1). */
+int heat_spin_alert( LONG *futex )
+{
+    unsigned long long budget = heat_spin_budget( HEAT_SPIN_LOCK ), start;
+    LONG expected = 0;
+    unsigned int i;
+
+    if (!budget) return 0;
+    if (!__atomic_compare_exchange_n( futex, &expected, 3, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+        return 0;   /* already alerted: the old path takes it */
+    start = heat_now();
+    for (i = 1;; i++)
+    {
+        if (__atomic_load_n( futex, __ATOMIC_ACQUIRE ) != 3) break;
+        YieldProcessor();
+        if (!(i & 15) && heat_now() - start >= budget) break;
+    }
+    expected = 3;
+    if (__atomic_compare_exchange_n( futex, &expected, 0, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+    {
+        heat_spin_result( HEAT_SPIN_LOCK, 0, start );
+        return 0;
+    }
+    __atomic_store_n( futex, 0, __ATOMIC_SEQ_CST );   /* it is 1: take the alert */
+    heat_spin_result( HEAT_SPIN_LOCK, 1, start );
+    return 1;
+}
+
+/***********************************************************************
+ *  dump
+ */
+
+static const char * const heat_counter_names[HC_NB] =
+{
+    "yield", "delay0", "delay",
+    "wait", "wait0", "wait_to", "w<20us", "w<200us", "w<2ms", "w>=2ms",
+    "alertwait", "alert", "cevent", "close", "setev", "resetev",
+    "relsem", "dup", "qpc", "srv", "pool_hit", "pool_put",
+    "wake_none", "wake_one", "woken", "spurious",
+    "aw<5us", "aw<20us", "aw<100us", "aw>=100us", "wake_skipped",
+    "lspin_hit", "lspin_miss", "espin_hit", "espin_miss", "spin_off", "clock_skipped", "spin_scoped", "unreg", "portfix",
+};
+static const char * const heat_timer_names[HT_NB] = { "delay", "wait", "alertwait", "srv", "cevent", "close", "spin" };
+
+static void heat_dump( FILE *f, double secs, double dt )
+{
+    LONG i, n = heat_nthreads < HEAT_MAX_THREADS ? heat_nthreads : HEAT_MAX_THREADS;
+    unsigned long long tot_user = 0, tot_sys = 0;
+    unsigned int k;
+
+    fprintf( f, "T %.1f dt %.2f threads %d\n", secs, dt, (int)n );
+    for (i = 0; i < n; i++)
+    {
+        struct heat_thread *t = &heat_threads[i];
+        unsigned long long user = t->pcpu_user, sys = t->pcpu_sys, c[HC_NB], tm[HT_NB];
+        const char *name = "";
+        BOOL alive = FALSE, any = FALSE;
+#ifdef __APPLE__
+        struct proc_threadinfo pti;
+        if (t->utid && proc_pidinfo( getpid(), PROC_PIDTHREADID64INFO, t->utid, &pti, sizeof(pti) ) == sizeof(pti))
+        {
+            alive = TRUE;
+            user = pti.pth_user_time;
+            sys = pti.pth_system_time;
+            name = pti.pth_name;
+        }
+#endif
+        for (k = 0; k < HC_NB; k++) { c[k] = t->c[k]; any |= c[k] != t->pc[k]; }
+        for (k = 0; k < HT_NB; k++) tm[k] = t->t[k];
+        if (!any && user == t->pcpu_user && sys == t->pcpu_sys) continue;
+        tot_user += user - t->pcpu_user;
+        tot_sys += sys - t->pcpu_sys;
+        fprintf( f, "thr %5x start %p%s%s cpu %5.1f%% usr %5.1f%% sys %5.1f%%",
+                 (unsigned int)t->tid, t->start, alive ? "" : " exited", "",
+                 (user + sys - t->pcpu_user - t->pcpu_sys) / (dt * 1e7),
+                 (user - t->pcpu_user) / (dt * 1e7), (sys - t->pcpu_sys) / (dt * 1e7) );
+#ifdef __APPLE__
+        if (alive) fprintf( f, " pri %d/%d", pti.pth_priority, pti.pth_curpri );
+#endif
+        if (t->qos)
+        {
+            char qos[32];
+            heat_qos_format( t->qos, qos, sizeof(qos) );
+            if (t->prio == 99) fprintf( f, " qos %s(by name ret %d)", qos, t->qos_ret );
+            else fprintf( f, " qos %s(prio %d ret %d)", qos, (int)t->prio, t->qos_ret );
+        }
+        if (name[0]) fprintf( f, " name \"%s\"", name );
+        fprintf( f, "\n    per s:" );
+        for (k = 0; k < HC_NB; k++)
+            if (c[k] != t->pc[k]) fprintf( f, " %s %.0f", heat_counter_names[k], (c[k] - t->pc[k]) / dt );
+        fprintf( f, "\n    ms/s:" );
+        for (k = 0; k < HT_NB; k++)
+            if (tm[k] != t->pt[k]) fprintf( f, " %s %.2f", heat_timer_names[k], (tm[k] - t->pt[k]) / (dt * 1e6) );
+        fprintf( f, "\n" );
+        memcpy( t->pc, c, sizeof(c) );
+        memcpy( t->pt, tm, sizeof(tm) );
+        t->pcpu_user = user;
+        t->pcpu_sys = sys;
+    }
+    fprintf( f, "total cpu %.1f%% usr %.1f%% sys %.1f%% (threads with a probe)\n",
+             (tot_user + tot_sys) / (dt * 1e7), tot_user / (dt * 1e7), tot_sys / (dt * 1e7) );
+
+    for (k = 0; k < REQ_NB_REQUESTS; k++)
+    {
+        unsigned long long rn = heat_req_n[k], rt = heat_req_t[k];
+        if (rn == heat_req_pn[k]) continue;
+        fprintf( f, "req %3u per s %.0f ms/s %.2f\n", k, (rn - heat_req_pn[k]) / dt, (rt - heat_req_pt[k]) / (dt * 1e6) );
+        heat_req_pn[k] = rn;
+        heat_req_pt[k] = rt;
+    }
+    for (k = 0; k < HEAT_CALLERS; k++)
+    {
+        struct heat_caller *e = &heat_callers[k];
+        unsigned long long key = e->key, cn = e->n;
+        if (!key || cn == e->pn) continue;
+        fprintf( f, "caller %s rva %#llx %#llx per s %.0f\n", heat_kind_names[(key >> 60) - 1],
+                 (key >> 30) & 0x3fffffff, key & 0x3fffffff, (cn - e->pn) / dt );
+        e->pn = cn;
+    }
+    if (heat_callers_lost) fprintf( f, "callers lost %llu\n", heat_callers_lost );
+    if (heat_mode & HEAT_EVPOOL)
+        fprintf( f, "evpool parked auto %u manual %u evicted %llu forgotten %llu double_close %llu\n",
+                 heat_pools[0].count, heat_pools[1].count, heat_pool_evicted, heat_pool_forgotten,
+                 heat_pool_double_close );
+    fflush( f );
+}
+
+static void *heat_dump_thread( void *arg )
+{
+    unsigned long long t0 = heat_now(), prev = t0;
+    unsigned int ticks = 0;
+    FILE *f;
+
+    if (!(f = fopen( heat_log_path, "a" ))) return NULL;
+    fprintf( f, "heat pid %d mode %#x image %#lx code %#lx-%#lx protocol %d interval %u\n",
+             (int)getpid(), heat_mode, (unsigned long)heat_image_base, (unsigned long)heat_code_lo,
+             (unsigned long)heat_code_hi, SERVER_PROTOCOL_VERSION, heat_interval );
+    fflush( f );
+    for (;;)
+    {
+        unsigned long long now;
+        sleep( 1 );
+        heat_control_poll( f );
+        if (++ticks < heat_interval) continue;
+        ticks = 0;
+        now = heat_now();
+        /* the counts keep running while counting is off; a dump after it, a long interval */
+        if (heat_mode & HEAT_COUNT)
+        {
+            heat_dump( f, (now - t0) / 1e9, (now - prev) / 1e9 );
+            if (heat_prof_rings)
+                fprintf( f, "prof sent %llu/%llu/%llu/%llu dropped %llu/%llu/%llu/%llu\n",
+                         heat_prof_rings[0].sent, heat_prof_rings[1].sent, heat_prof_rings[2].sent,
+                         heat_prof_rings[3].sent, heat_prof_rings[0].dropped, heat_prof_rings[1].dropped,
+                         heat_prof_rings[2].dropped, heat_prof_rings[3].dropped );
+        }
+        prev = now;
+    }
+    return NULL;
+}
+
+/* WINE_HEAT_METAL_HUD: called once by heat_decide, before any PE code (and so before winemac's
+ * first Metal device); one line to stderr, and to the heat log when WINE_HEAT_LOG is set */
+static void heat_metal_hud(void)
+{
+    const char *old = getenv( "MTL_HUD_ENABLED" ), *dir = getenv( "WINE_HEAT_LOG" );
+    char path[1024], line[256];
+    FILE *f;
+
+    if (old)
+        snprintf( line, sizeof(line), "heat pid %d metal_hud: MTL_HUD_ENABLED=%s already set, kept\n",
+                  (int)getpid(), old );
+    else
+    {
+        setenv( "MTL_HUD_ENABLED", "1", 0 );
+        snprintf( line, sizeof(line), "heat pid %d metal_hud: MTL_HUD_ENABLED=1 set (WINE_HEAT_METAL_HUD)\n",
+                  (int)getpid() );
+    }
+    fputs( line, stderr );
+    if (!dir || !*dir) return;
+    snprintf( path, sizeof(path), "%s/heat-%d.log", dir, (int)getpid() );
+    if ((f = fopen( path, "a" )))
+    {
+        fputs( line, f );
+        fclose( f );
+    }
+}
+
+/***********************************************************************
+ *  heat_decide
+ *
+ * Called by the first probe; returns the mode, 0 while the process parameters aren't there yet.
+ */
+unsigned int heat_decide(void)
+{
+    static LONG deciding;
+    const char *count = getenv( "WINE_HEAT_COUNT" ), *evpool = getenv( "WINE_HEAT_EVPOOL" );
+    const char *qos = getenv( "WINE_HEAT_QOS" ), *exe = getenv( "WINE_HEAT_EXE" ), *s;
+    const char *wake = getenv( "WINE_HEAT_WAKE" ), *names = getenv( "WINE_HEAT_NAMEPRI" );
+    const char *prof = getenv( "WINE_HEAT_PROF" ), *control = getenv( "WINE_HEAT_CONTROL" );
+    const char *spin = getenv( "WINE_HEAT_SPIN" ), *lazyclock = getenv( "WINE_HEAT_LAZYCLOCK" );
+    const char *unreg = getenv( "WINE_HEAT_MSYNC_UNREG" ), *portfix = getenv( "WINE_HEAT_MSYNC_PORTFIX" );
+    const char *metalhud = getenv( "WINE_HEAT_METAL_HUD" );
+    RTL_USER_PROCESS_PARAMETERS *params;
+    const WCHAR *path, *base;
+    unsigned int mode = 0, i, len;
+
+    if (!count && !evpool && !qos && !wake && !names && !prof && !control && !spin && !lazyclock && !unreg && !portfix
+        && !metalhud) goto done;
+    if (!peb || !(params = peb->ProcessParameters) || !params->ImagePathName.Length) return 0;
+    path = params->ImagePathName.Buffer;
+    if (!(params->Flags & PROCESS_PARAMS_FLAG_NORMALIZED)) path = (const WCHAR *)((const char *)params + (ULONG_PTR)path);
+    if (!path) return 0;
+    if (InterlockedCompareExchange( &deciding, 1, 0 )) return 0;
+
+    len = params->ImagePathName.Length / sizeof(WCHAR);
+    for (base = path, i = 0; i < len; i++) if (path[i] == '\\' || path[i] == '/') base = path + i + 1;
+    if (!exe) exe = "Gw2-64.exe";
+    for (s = exe; base < path + len && *s; base++, s++)
+    {
+        WCHAR a = *base, b = (unsigned char)*s;
+        if (a >= 'A' && a <= 'Z') a += 'a' - 'A';
+        if (b >= 'A' && b <= 'Z') b += 'a' - 'A';
+        if (a != b) break;
+    }
+    if (*s || base != path + len) goto done;
+
+    if (metalhud && atoi( metalhud )) heat_metal_hud();  /* not a mode: nothing to probe */
+    if (count && atoi( count )) mode |= HEAT_COUNT;
+    if (evpool && atoi( evpool )) mode |= HEAT_EVPOOL;
+    if (qos && heat_parse_qos( qos )) mode |= HEAT_QOS;
+    if (wake && strstr( wake, "one" )) mode |= HEAT_WAKE;
+    if (wake && strstr( wake, "skip" )) mode |= HEAT_WAKESKIP;
+    if (names && heat_parse_names( names )) mode |= HEAT_NAMEPRI;
+    if (prof && (!strcmp( prof, "on" ) || !strcmp( prof, "1" ))) mode |= HEAT_PROF;
+    if (spin) mode |= heat_parse_spin( spin );
+    if (lazyclock && atoi( lazyclock )) mode |= HEAT_LAZYCLOCK;
+    if (unreg && atoi( unreg )) mode |= HEAT_UNREG;
+    if (portfix && atoi( portfix )) mode |= HEAT_PORTFIX;
+    if ((s = getenv( "WINE_HEAT_SPIN_PAUSE" )) && atoi( s ) > 0) heat_spin_pause = atoi( s );
+    if ((s = getenv( "WINE_HEAT_PROF_RENDER" )) && atoi( s )) heat_prof_want |= 2;
+    if ((s = getenv( "WINE_HEAT_PROF_THREADS" )) && heat_prof_parse_targets( s )) heat_prof_want = heat_prof_parse_targets( s );
+    if (control && *control)
+    {
+        snprintf( heat_control_path, sizeof(heat_control_path), "%s", control );
+        mode |= HEAT_LIVE | HEAT_TRACK;
+    }
+
+#ifdef __APPLE__
+    {
+        mach_timebase_info_data_t tb;
+        if (mach_timebase_info( &tb ) == KERN_SUCCESS && tb.denom) heat_ns_per_tick = (double)tb.numer / tb.denom;
+    }
+#endif
+    if ((s = getenv( "WINE_HEAT_EVPOOL_AGE_US" ))) heat_pool_age_ns = strtoull( s, NULL, 10 ) * 1000;
+    if ((s = getenv( "WINE_HEAT_INTERVAL" )) && atoi( s ) > 0) heat_interval = atoi( s );
+    if (mode & HEAT_EVPOOL)
+    {
+        heat_evflags = anon_mmap_alloc( HEAT_EVFLAGS_SIZE, PROT_READ | PROT_WRITE );
+        if (heat_evflags == MAP_FAILED) { heat_evflags = NULL; mode &= ~HEAT_EVPOOL; }
+    }
+    if (mode & (HEAT_WAKESKIP | HEAT_TRACK))
+    {
+        heat_semflags = anon_mmap_alloc( HEAT_SEMFLAGS_SIZE, PROT_READ | PROT_WRITE );
+        heat_waiters = anon_mmap_alloc( HEAT_WAITERS_SIZE * sizeof(int), PROT_READ | PROT_WRITE );
+        if (heat_semflags == MAP_FAILED || heat_waiters == MAP_FAILED)
+        {
+            heat_semflags = NULL;
+            heat_waiters = NULL;
+            mode &= ~(HEAT_WAKESKIP | HEAT_TRACK);
+        }
+    }
+    if ((s = getenv( "WINE_HEAT_PROF_HZ" )) && atoi( s ) > 0 && atoi( s ) <= 10000) heat_prof_hz = atoi( s );
+    if (mode & (HEAT_PROF | HEAT_LIVE))
+    {
+        struct sigaction sa;
+
+        heat_prof_rings = anon_mmap_alloc( (HEAT_PROF_TARGETS * sizeof(*heat_prof_rings) + 0xffff) & ~(SIZE_T)0xffff,
+                                           PROT_READ | PROT_WRITE );
+        if (heat_prof_rings == MAP_FAILED) { heat_prof_rings = NULL; mode &= ~HEAT_PROF; }
+        else
+        {
+            heat_prof_usyms = anon_mmap_alloc( HEAT_PROF_USYMS * sizeof(*heat_prof_usyms), PROT_READ | PROT_WRITE );
+            if (heat_prof_usyms == MAP_FAILED) heat_prof_usyms = NULL;
+            /* not SA_ONSTACK: it runs on the interrupted stack (PE stacks have no red zone to
+             * keep, and the kernel skips the unix one's), and stays off Wine's signal stack */
+            memset( &sa, 0, sizeof(sa) );
